# Tutto è facoltativo: senza .env Marv usa Ollama in locale con gemma4:e2b.

# --- Modello locale (default) ---
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:e2b
OLLAMA_HOST=http://localhost:11434
OLLAMA_AUTOSTART=1        # avvia `ollama serve` se non risponde
OLLAMA_AUTOPULL=1         # scarica il modello se manca
OLLAMA_KEEP_ALIVE=-1      # modello in memoria finché MarvHub è attivo
# OLLAMA_TEMPERATURE=0.8
# OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_PREDICT=512

# --- In alternativa: Groq o altro endpoint compatibile OpenAI ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=            # oppure GROQ_API
# LLM_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=low

# --- Marv ---
MARV_COOLDOWN_SECONDS=30     # pausa minima tra due notifiche (eventi high la scavalcano)
MARV_TYPING_DEBOUNCE=4       # secondi di pausa nella digitazione prima di inviare notepad.typing
MARV_FAKE_LLM=0              # 1 = risposte finte senza modello (test/offline)

# --- Hub ---
EWA_HUB_PORT=47474
EWA_HUB_IDLE_EXIT=600        # MarvHub si spegne dopo N secondi senza tool aperti
