# --- Provider LLM (qualsiasi endpoint compatibile OpenAI) ---
# Groq (default)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=            # oppure GROQ_API (compatibile con marv.py)
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low   # low|medium|high, solo modelli gpt-oss; vuoto per disattivare
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.8
# Ollama locale (esempio):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b

# --- Marv ---
MARV_COOLDOWN_SECONDS=30     # pausa minima tra due notifiche (eventi high la scavalcano)
MARV_TYPING_DEBOUNCE=4       # secondi di pausa nella digitazione prima di inviare notepad.typing
MARV_FAKE_LLM=0              # 1 = risposte finte senza API (test/offline)

# --- Hub ---
EWA_HUB_PORT=47474
